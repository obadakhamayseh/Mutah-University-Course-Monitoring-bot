# Telegram Bot Token (obtained from @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Database URL
# For SQLite (default, zero-setup):
DATABASE_URL=sqlite+aiosqlite:///./mutah_bot.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mutah_courses

# Portal & Polling Settings
PORTAL_URL=https://subp.mutah.edu.jo/
PORTAL_TIMEOUT_SECONDS=25
SESSION_CACHE_TTL_SECONDS=300
CHECK_INTERVAL_SECONDS=60
REQUEST_DELAY_SECONDS=2.0

# Optional Admin Telegram ID for notifications & logs
ADMIN_TELEGRAM_ID=
LOG_LEVEL=INFO
